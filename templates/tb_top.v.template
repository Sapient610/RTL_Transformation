// ==============================================================================
// 评估基座通用测试平台（Testbench）模板样例：tb_top.v
// ==============================================================================
// 
// 核心契约与规范要求：
// 1. 顶层模块名称必须为: tb_top
// 2. 被测设计（DUT）例化名称必须为: u_dut
// 3. VCD 波形转储必须限定于 DUT 层次作用域: $dumpvars(0, tb_top.u_dut)
// 4. VCD 文件名支持通过命令行参数 +VCD_FILE=<path> 动态反标，或缺省输出
// 5. 激励生成建议覆盖典型工作场景（产生足够多的引脚活跃翻转），以便 OpenSTA 准确反标
// ==============================================================================

`timescale 1ns/1ps

module tb_top;

    // --------------------------------------------------------------------------
    // 1. 时钟、复位与信号定义
    // --------------------------------------------------------------------------
    reg clk;
    reg rst_n;

    // [TODO]: 依据被测模块端口定义激励信号
    // reg  [DATA_WIDTH-1:0] in_data;
    // wire [DATA_WIDTH-1:0] out_data;

    // --------------------------------------------------------------------------
    // 2. 时钟信号生成（周期需与 meta.json 中 clock_period_ns 一致或成比例）
    // --------------------------------------------------------------------------
    localparam CLK_PERIOD = 10; // 10ns = 100MHz
    always #(CLK_PERIOD / 2) clk = ~clk;

    // --------------------------------------------------------------------------
    // 3. DUT 实例化（契约要求：例化名必须严格为 u_dut）
    // --------------------------------------------------------------------------
    // <TOP_MODULE_NAME> u_dut (
    //     .clk      (clk),
    //     .rst_n    (rst_n),
    //     .in_data  (in_data),
    //     .out_data (out_data)
    // );

    // --------------------------------------------------------------------------
    // 4. 波形转储契约：转储 tb_top.u_dut 作用域下的全部信号
    // --------------------------------------------------------------------------
    reg [1023:0] vcd_file;
    initial begin
        // 优先通过 runtime plusargs 获取 VCD 输出路径；若未传参则回退为缺省命名
        if (!$value$plusargs("VCD_FILE=%s", vcd_file)) begin
            `ifdef DEFAULT_VCD_FILE
                vcd_file = `DEFAULT_VCD_FILE;
            `else
                vcd_file = "activity.vcd";
            `endif
        end

        $dumpfile(vcd_file);
        $dumpvars(0, tb_top.u_dut);
        $display("[TB] VCD dumping started into: %0s", vcd_file);
    end

    // --------------------------------------------------------------------------
    // 5. 测试激励与真实业务翻转产生
    // --------------------------------------------------------------------------
    initial begin
        // 初始化信号
        clk   = 0;
        rst_n = 0;
        // in_data = 0;

        // 复位释放
        #(CLK_PERIOD * 2);
        rst_n = 1;

        // 产生业务测试向量（示例：连续 200 个周期的随机激励）
        repeat (200) begin
            @(posedge clk);
            // in_data <= $urandom;
        end

        // 等待流水线清空并结束
        #(CLK_PERIOD * 5);
        $display("[TB] Simulation completed successfully.");
        $finish;
    end

endmodule

